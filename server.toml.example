# Text-to-shaberi サーバ設定
# docs/IMPL-R0.md §3.5

[bind]
host  = "127.0.0.1"              # 外部公開時は 0.0.0.0 + token 必須
port  = 8765
token = ""                       # 外部bind時は必須（空なら起動拒否）
tls_cert = ""                    # TLS 証明書パス（両方指定で TLS 有効）
tls_key  = ""                    # TLS 秘密鍵パス

[stt]
backend  = "qwen_local"          # qwen_local | qwen_dashscope
language = "ja"
[stt.qwen_local]
model               = "Qwen/Qwen3-ASR-1.7B"
device              = "cuda:0"
dtype               = "bfloat16"
attn_implementation = "sdpa"     # flash-attn導入済みなら "flash_attention_2"

[tts]
profiles_dir    = ""             # 空=repo直下 profiles/ を使用
active_profile  = "gpt-sovits"   # profiles/tts/<name>.toml

[transport]
codec = "opus"                   # opus | pcm。非対応クライアント/opuslib不在には自動 pcm フォールバック
opus_bitrate = 24000             # bps
