# docker compose 変数（このファイルを .env にコピーして編集）
#   cp deploy/.env.example .env
# .env は .gitignore 済み。

# Windows クライアントが繋ぐ WS の公開ポート（host:container = WS_PORT:8765）
WS_PORT=8765

# 使用する GPU の index（nvidia-smi の index）。単一GPUなら 0。
GPU_ID=0

# 【必須・マシン毎に要変更】GPT-SoVITS リポジトリ（重み込み）の絶対パス。
#   このホスト上に実在する GPT-SoVITS（api_v2.py と GPT_SoVITS/pretrained_models, text/G2PWModel を含む）を指すこと。
#   存在しないパスを指すと Docker が空ディレクトリをマウントし、イメージ内の api_v2.py が隠れて起動失敗する。
#   確認: ls "$GPTSOVITS_DIR/api_v2.py"
GPTSOVITS_DIR=/path/to/GPT-SoVITS

# ref.wav を含む assets ディレクトリ。gpt-sovits へ /refs:ro でマウントする。
#   注: assets/*.wav は .gitignore 済み＝新規 clone には ref.wav が無い。別の場所にあるならそのパスを指定。
#   確認: ls "$SHABERI_ASSETS/ref.wav"
SHABERI_ASSETS=./assets
