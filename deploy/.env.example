# docker compose 変数（このファイルを .env にコピーして編集）
#   cp deploy/.env.example .env
# .env は .gitignore 済み。

# Windows クライアントが繋ぐ WS の公開ポート（host:container = WS_PORT:8765）
WS_PORT=8765

# 使用する GPU の index（nvidia-smi の index）。単一GPUなら 0。
GPU_ID=0

# GPT-SoVITS リポジトリ（重み込み）の絶対パス。gpt-sovits サービスへ bind-mount する。
GPTSOVITS_DIR=/mnt/holyland/Project/GPT-SoVITS

# ref.wav を含む assets ディレクトリ。gpt-sovits へ /refs:ro でマウントする。
SHABERI_ASSETS=./assets
